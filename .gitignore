# =============================================================================
# Terraform
# =============================================================================

# Local .terraform directories
**/.terraform/*

# .tfstate files (contain sensitive data - NEVER commit)
*.tfstate
*.tfstate.*
.terraform/

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
*.tfplan
tfplan.out

# Ignore CLI configuration files
.terraformrc
terraform.rc

# =============================================================================
# Azure / Azure CLI
# =============================================================================

.azure/

# =============================================================================
# Kubernetes
# =============================================================================

# kubeconfig si alguna vez se exporta local (az aks get-credentials)
kubeconfig
*.kubeconfig

# =============================================================================
# Environment & secrets
# =============================================================================

.env
.env.*
*.pem
*.key
*.crt
*.pfx
*credentials*
*secrets*

# =============================================================================
# OS / editor files
# =============================================================================

.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
*.code-workspace
.idea/

# =============================================================================
# Logs
# =============================================================================

*.log
